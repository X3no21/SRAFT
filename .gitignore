# Key material generated by scripts/tls/generate_certs.sh — never commit.
# main/certs/ is deliberately NOT ignored: the three files there are tracked as
# placeholders because EMBED_TXTFILES requires them to exist. After running
# generate_certs.sh they contain real keys — check `git status` before commits.
scripts/tls/ca/
scripts/tls/certs/
*.key
!main/certs/device.key
.env