# Prerequisites
*.d

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod
*.smod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app

build
cmake-build-*
venv
__pycache__
logs
experiment_results*
managed_components
# raw fault-scenario runs read by statistics_report.py and update_paper_results.py
!experimental_results/experiment_results/

# IDE project files
.idea/

# ESP-IDF leftovers
sdkconfig.old

# Key material generated by scripts/tls/generate_certs.sh — never commit.
# main/certs/ is deliberately NOT ignored: the three files there are tracked as
# placeholders because EMBED_TXTFILES requires them to exist. The real files are
# written to main/certs_local/ (ignored below), which the build prefers when present.
scripts/tls/ca/
scripts/tls/certs/
*.key
!main/certs/device.key
.env

# Real credentials used locally in place of the tracked placeholders — never commit
main/certs_local/
main/esp32_config/wifi_credentials.h
main/esp32_config/network_secret.h
scripts/server/.env

# Release profile of the firmware (generated)
build_release
sdkconfig.release
sdkconfig.release.old

# Tampered test image (failed-attestation scenario)
build_tampered
build_release_tampered
build_tamper*
build_release_tamper*
build_attack

# Windows alternate-data-stream metadata created when files are copied from Windows
*:Zone.Identifier
