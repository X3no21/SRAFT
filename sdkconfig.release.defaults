# Release profile: the firmware used for the measurements. Applied on top of the project sdkconfig
# (see scripts/tests/pipeline.py build --profile release). The log statements are compiled out, so
# that writing to the serial console does not slow down the protocol or perturb the measurements;
# the measurements themselves reach the monitoring server over the network.
CONFIG_LOG_DEFAULT_LEVEL_NONE=y
CONFIG_LOG_MAXIMUM_EQUALS_DEFAULT=y
CONFIG_BOOTLOADER_LOG_LEVEL_NONE=y
